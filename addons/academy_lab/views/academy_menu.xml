<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Root -->
    <menuitem id="menu_academy_root"
              name="Academy"
              sequence="10"/>

    <!-- Courses -->
    <menuitem id="menu_academy_courses"
            name="Courses"
            parent="menu_academy_root"
            action="academy_course_action"
            sequence="10"/>

    <!-- Enrollments (Parent) -->
    <menuitem id="menu_academy_enrollments"
              name="Enrollments"
              parent="menu_academy_root"
              sequence="20"/>

    <!-- All Enrollments (Instructor / Manager) -->
    <menuitem id="menu_academy_enrollments_all"
              name="All Enrollments"
              parent="menu_academy_enrollments"
              action="academy_enrollment_action"
              groups="academy_lab.academy_group_instructor,academy_lab.academy_group_manager"
              sequence="10"/>

    <!-- My Enrollments (Student) -->
    <record id="academy_my_enrollments_action" model="ir.actions.act_window">
        <field name="name">My Enrollments</field>
        <field name="res_model">academy.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_enrollments': 1}</field>
    </record>

    <menuitem id="menu_academy_my_enrollments"
              name="My Enrollments"
              parent="menu_academy_enrollments"
              action="academy_my_enrollments_action"
              groups="academy_lab.academy_group_student"
              sequence="20"/>

</odoo>
